{
    "manifest_version": 3,
    "name": "LinkYard",
    "version": "0.1.0",
    "description": "Right-click, collect, keep moving. Project-based link collections stored locally, without accounts or tracking.",
    "minimum_chrome_version": "116",
    "permissions": ["storage", "contextMenus", "sidePanel"],
    "background": {
        "service_worker": "src/background/service-worker.js",
        "type": "module"
    },
    "action": {
        "default_title": "Open LinkYard",
        "default_icon": {
            "16": "src/assets/icons/icon-16.png",
            "32": "src/assets/icons/icon-32.png",
            "48": "src/assets/icons/icon-48.png",
            "128": "src/assets/icons/icon-128.png"
        }
    },
    "icons": {
        "16": "src/assets/icons/icon-16.png",
        "32": "src/assets/icons/icon-32.png",
        "48": "src/assets/icons/icon-48.png",
        "128": "src/assets/icons/icon-128.png"
    },
    "side_panel": {
        "default_path": "src/sidepanel/index.html"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
    }
}
