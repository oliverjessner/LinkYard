# Chrome Web Store API v2. Copy this file to .env and fill in your values.
# Setup: https://developer.chrome.com/docs/webstore/using-api
# Publisher ID: Developer Dashboard > Account/Publisher > Settings.
# Extension ID: the existing item's ID in the Developer Dashboard.
CWS_PUBLISHER_ID=
CWS_EXTENSION_ID=

# OAuth scope: https://www.googleapis.com/auth/chromewebstore
# Authorize with the Google account that owns the Web Store item.
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
